# ---------------------------------------
# BANGALIR BERANO — Frontend Environment
# Copy this file to .env and fill in values
# ---------------------------------------
# All Vite env vars MUST start with VITE_ to be exposed to the browser

# Backend API base URL
# Local dev  -> http://localhost:5000/api
# Production -> https://api.yourdomain.com/api  (set this to your deployed backend)
VITE_API_URL=http://localhost:5000/api

