# ═══════════════════════════════════════
# BANGALIR BERANO — Backend Environment
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════

# Server
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Admin credentials
ADMIN_ID=admin
ADMIN_PASSWORD=your_secure_password_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Frontend origin — used in CORS (set to your production domain)
# Examples:
#   Local dev   -> http://localhost:5173
#   Production  -> https://www.bangalirberano.com
FRONTEND_URL=https://www.bangalirberano.com

# Email SMTP Settings
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_smtp_password

# Company info (appears in email footers)
COMPANY_NAME=Bangalir Berano
COMPANY_EMAIL=contact@bangalirberano.com
COMPANY_PHONE=+91 9830033647
