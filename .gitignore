# Dependencies
node_modules/
*/node_modules/

# Production build artifacts
dist/
dist-ssr/
build/
*/dist/
*/dist-ssr/
*/build/

# Environment files & Secrets — NEVER commit real credentials
.env
.env.local
.env.*.local
*.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# Allow example files (safe for git)
!.env.example
!frontend/.env.example
!backend/.env.example

# Backend Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary scratch & patch scripts
temp.txt
*.tmp
patch*.py
fix_*.js
fix_*.py
clean_*.js
check_*.js
find_*.js
count_*.js
found_*.txt
git_*.txt
user_paste.*
destinations_replacements.json
full_step_content.txt
frontend/patch_*.py
frontend/replace_*.py
